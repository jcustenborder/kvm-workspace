{
  "name": "kvm-workspace",
  "productName": "KVM Workspace",
  "version": "0.1.0",
  "description": "Independent macOS windows for direct GLKVM sessions",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "node scripts/package.mjs",
    "test:windows": "node scripts/validate-windows.cjs",
    "test:inventory": "node scripts/validate-inventory.cjs",
    "test:passwords": "node scripts/validate-passwords.cjs",
    "test:api": "node scripts/validate-api.cjs",
    "test:live": "node scripts/validate-live.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.1.0",
    "playwright-core": "1.58.2"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "electron-updater": "6.8.11"
  }
}
